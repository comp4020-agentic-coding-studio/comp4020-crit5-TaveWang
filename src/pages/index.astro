---
import "../styles/global.css";
import GameCanvas from "../components/GameCanvas";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ashen Hollow</title>
    <meta
      name="description"
      content="Ashen Hollow: a short, original side-scrolling action roguelite about a masked wanderer and a single dash-slash through a ruined sanctuary."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="visually-hidden">
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
      <h1>Ashen Hollow</h1>
    </header>
    <main>
      <GameCanvas client:load />
    </main>
  </body>
</html>
